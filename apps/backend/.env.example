# Backend environment configuration (example only)
APP_ENV=development
API_V1_PREFIX=/api/v1

# PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# NoSQL (document metadata, agent state)
NOSQL_URL=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal service URLs
CHATBOT_SERVICE_URL=http://localhost:8001
VOICE_AGENT_SERVICE_URL=http://localhost:8002
AUTOMATION_SERVICE_URL=http://localhost:8003

# Object storage (future)
OBJECT_STORAGE_URL=
