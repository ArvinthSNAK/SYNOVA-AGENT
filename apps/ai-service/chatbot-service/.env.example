# Copy this file to .env and fill in real values. Never commit .env itself.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here

OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=500

# --- Your API's own auth (clients must send X-API-Key: one-of-these) ---
# comma-separated, no spaces around commas needed
API_KEYS= authentication key u can CREATE (likegmail password)

ALLOWED_ORIGINS=http://localhost:5173