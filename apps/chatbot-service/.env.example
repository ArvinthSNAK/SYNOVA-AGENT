APP_ENV=development
API_V1_PREFIX=/api/v1

AI_PROVIDER_API_KEY=
# Preferred env var for OpenAI usage (used by the chatbot). You can set either
# `OPENAI_API_KEY` or `AI_PROVIDER_API_KEY`. Example:
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=
BACKEND_API_URL=http://localhost:8000
